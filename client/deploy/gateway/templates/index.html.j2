<!DOCTYPE html>
<html lang="it">
<head>
  <base href="/">

  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="{{ theme_color }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="{{ short_name }}">
  <link rel="apple-touch-icon" href="{{ icon_src }}">

  <link rel="icon" type="image/png" href="{{ favicon_url }}"/>

  <title>{{ display_name }}</title>
  <link rel="manifest" href="manifest.json">

  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      background-color: {{ background_color }};
    }

    #alfred-boot-splash {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      background-color: {{ background_color }};
      color: #ffffff;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      transition: opacity 0.2s ease-out;
    }

    #alfred-boot-splash.alfred-boot-splash--hide {
      opacity: 0;
      pointer-events: none;
    }

    #alfred-boot-splash img {
      width: 96px;
      height: 96px;
      border-radius: 20px;
    }

    #alfred-boot-splash .alfred-boot-title {
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    #alfred-boot-splash .alfred-boot-spinner {
      width: 28px;
      height: 28px;
      border: 3px solid rgba(255, 255, 255, 0.25);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: alfred-boot-spin 0.8s linear infinite;
    }

    @keyframes alfred-boot-spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div id="alfred-boot-splash" role="status" aria-live="polite" aria-label="Caricamento">
    <img src="{{ logo_url }}" alt="" width="96" height="96">
    <div class="alfred-boot-title">Caricamento…</div>
    <div class="alfred-boot-spinner" aria-hidden="true"></div>
  </div>

  <script>
    (function () {
      function hideBootSplash() {
        var splash = document.getElementById('alfred-boot-splash');
        if (!splash || splash.dataset.hidden === '1') return;
        splash.dataset.hidden = '1';
        splash.classList.add('alfred-boot-splash--hide');
        window.setTimeout(function () {
          splash.remove();
        }, 220);
      }

      window.addEventListener('flutter-first-frame', hideBootSplash);
      window.setTimeout(hideBootSplash, 45000);
    })();
  </script>

  <script src="flutter_bootstrap.js" async></script>
  <script defer src="https://github.com/corbado/flutter-passkeys/releases/download/2.5.0/bundle.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js"></script>
</body>
</html>
