@startuml seq-login
' Context: auth
' Profile: client
' SDD: SURF-AUTH-004, SURF-AUTH-007
' Revision: 2026-07-27

title Auth — login (password)

actor Utente
participant "UI" as UI
participant "AuthMachine" as AM
participant "MultiAccountMachine" as MAM
participant "AccountManager" as Mgr
participant "Supabase GoTrue" as GT

Utente -> UI : SignIn (email, password)
note over UI : validate email (AuthIdentity)
alt email non valida
  UI -> AM : ValidationRejected
else email ok
  UI -> AM : AuthOperationStarted
  UI -> MAM : OpenAccountWithPassword
  MAM -> Mgr : sign in + open account
  Mgr -> GT : authenticate
  GT --> Mgr : session
  Mgr -> Mgr : adopt session per account
  Mgr --> MAM : AccountOpened
  MAM --> MAM : AccountFocused
  MAM --> UI : account aperto
  UI -> AM : AuthOperationCompleted\n[success]
  AM --> UI : SessionActive\noverlay chiuso
end

@enduml
