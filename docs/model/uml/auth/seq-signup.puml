@startuml seq-signup
' Context: auth
' Profile: client
' SDD: SURF-AUTH-004, SURF-AUTH-006, SURF-AUTH-008
' Revision: 2026-07-27

title Auth — registrazione

actor Utente
participant "UI" as UI
participant "AuthMachine" as AM
participant "MultiAccountMachine" as MAM
participant "AccountManager" as Mgr
participant "Supabase GoTrue" as GT

Utente -> UI : SignUp
note over UI : validate email, username, displayName
alt validazione fallita
  UI -> AM : ValidationRejected
else validazione ok
  UI -> AM : AuthOperationStarted
  UI -> MAM : OpenAccountWithSignUp
  MAM -> Mgr : sign up + open account
  Mgr -> GT : is_username_available
  alt username occupato
    Mgr --> MAM : error
    MAM --> UI : error
    UI -> AM : AuthOperationFailed
  else username libero
    Mgr -> GT : authenticate (sign up)
    alt email non confermata
      GT --> Mgr : no session
      Mgr --> MAM : error
      MAM --> UI : error
      UI -> AM : AuthOperationFailed\n(conferma email)
    else session ok
      Mgr -> Mgr : adopt session per account
      Mgr --> MAM : AccountOpened
      MAM --> MAM : AccountFocused
      MAM --> UI : account aperto
      UI -> AM : AuthOperationCompleted\n[success]
      AM --> UI : SessionActive
    end
  end
end

@enduml
