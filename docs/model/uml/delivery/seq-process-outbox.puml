@startuml seq-process-outbox
' Context: delivery
' Profile: platform
' Command: ProcessDeliveryQueue
' SDD: SYS-DELIVERY-011
' Revision: 2026-09-05

title seq-process-outbox — dispatcher worker

participant "AccountBoundary" as AB
database "Outbox" as OB
participant "DeliveryWorker" as DW
participant "ReceptionGate" as GATE
participant "MailboxArchive" as MSG

AB -> OB : QueueDelivery / QueueReadReceipt / QueueGroupFanOut / QueueReactionFact
AB -> DW : ProcessDeliveryQueue

DW -> OB : read event_kind

alt event_kind = read_receipt
  DW -> DW : PropagateReadReceipt
  DW -> MSG : ReadReceiptPropagated
  DW -> OB : DeliveryCompleted
else event_kind = group_erogate
  DW -> DW : GroupErogate
  DW -> MSG : read group archive row
  DW -> DW : ErogateGroupMessage
  DW -> OB : GroupFanOutCompleted
else event_kind = push_notify
  DW -> DW : ProcessPushNotification
  DW -> OB : DeliveryCompleted
else event_kind = reaction_fact
  DW -> DW : ProcessReactionFact
  DW -> OB : DeliveryCompleted (+ reaction_fact_id)
else event_kind = deliver (default)
  DW -> DW : DeliverInternal
  DW -> GATE : EvaluateInboundDelivery
  alt DeliveryPermitted
    GATE --> DW : DeliveryPermitted
    DW -> MSG : RecipientNotified
    DW -> MSG : SenderDeliveredAtSet
    opt destinatario è gruppo
      DW -> DW : ErogateGroupMessage
    end
    opt recapito materializzato (SYS-PUSH)
      DW -> OB : QueuePushNotification
      DW -> DW : ProcessPushNotification
    end
    DW -> OB : DeliveryCompleted
  else DeliverySilentlyBlocked
    GATE --> DW : DeliverySilentlyBlocked
    DW -> OB : DeliveryCompleted
  end
end

DW --> AB : (stessa transazione)

note over AB, DW
  Internal: sincrono nel confine account.
  Federato: consumer = bridge (stub) — vedi federation.
end note

@enduml
