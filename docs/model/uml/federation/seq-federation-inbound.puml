@startuml seq-federation-inbound
' Context: federation
' Profile: platform
' Revision: 2026-09-15

title Federation — inbound federato (target)

participant "FederatedServer" as EXT
participant "GothamIngress" as GI
participant "ReceptionGate" as GATE
participant "MediaIngest" as MI
participant "InboxMaterialize" as IM

EXT -> GI : POST /gotham/v1/events\nGothamSignedEvent
GI -> GI : verify signature → signer_im_server_id
GI -> GATE : EvaluateInboundDelivery\nfqdn(from_user, signer)

alt allow list
  GATE --> GI : DeliveryPermitted
  opt MESSAGE con allegato
    GI -> EXT : GET media_fetch_url
    GI -> MI : store blob destinatario
  end
  GI -> IM : materialize copia\nauthor_address = fqdn(from_user, signer)\nmedia_url locale
  IM --> GI : InboundFederatedMessageReceived
else bloccato
  GATE --> GI : DeliverySilentlyBlocked
  note right of GI
    HTTP 2xx verso peer;
    nessuna copia destinatario.
  end note
end

@enduml
