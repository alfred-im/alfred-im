@startuml groups-state
' Context: groups
' Profile: client
' SDD: SYS-GROUP, SYS-DELIVERY (erogazione)
' Revision: 2026-07-27

title Groups — GroupHomeMachine + GroupMessagesMachine

state GroupHomeLoad {
  state GH_Loading
  state GH_Ready

  [*] --> GH_Loading : LoadGroupHome
  GH_Loading --> GH_Ready : GroupHomeLoaded
  GH_Loading --> GH_Ready : GroupHomeLoadFailed
  GH_Ready --> GH_Loading : LoadGroupHome
}

state GroupMessagesLoad {
  state GM_Loading
  state GM_Ready

  [*] --> GM_Loading : InitGroupMessages\nLoadGroupMessages
  GM_Loading --> GM_Ready : GroupMessagesLoaded
  GM_Loading --> GM_Ready : GroupMessagesLoadFailed
  GM_Ready --> GM_Loading : LoadGroupMessages
}

state GroupBroadcast {
  state GB_Idle
  state GB_Sending

  [*] --> GB_Idle
  GB_Idle --> GB_Sending : BroadcastRequested
  GB_Sending --> GB_Idle : BroadcastAcknowledged
  GB_Sending --> GB_Idle : BroadcastFailed
}

state GroupRealtime {
  state GR_Detached
  state GR_Attached

  [*] --> GR_Detached
  GR_Detached --> GR_Attached : InitGroupMessages
  GR_Attached --> GR_Detached : DisposeGroupMessages
}

note right of GB_Sending
  No optimistic bubble —
  serializes broadcast.
  LoadFailed / BroadcastFailed
  keep Ready / Idle; error
  string lives in coordinator UI state.
end note

note bottom of GroupRealtime
  OwnerRealtimeReceived is handled
  while Attached (no load-state change).
  Shell navigation (OpenGroupConversation /
  LeaveGroupConversation) is owned by
  navigation context — see navigation-shell-state.puml.
end note

@enduml
