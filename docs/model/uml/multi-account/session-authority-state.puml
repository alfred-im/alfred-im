@startuml session-authority-state
' Context: multi-account
' Profile: service (specifica logica — NON statechart Dart in client/lib/machines/)
' SDD: PROM-MULTI-ACCOUNT (enforcement interno — nessun amend osservabile)
' Revision: 2026-08-08
' Implementazione: client/lib/services/session_authority.dart (servizio imperativo)

title SessionAuthority — stati logici identità attiva\n(servizio dominio — non MultiAccountMachine)

state NoActiveIdentity
state FocusActive : activeFocusUserId + JWT\nleaseCount = 0
state FocusActiveLeased : activeFocusUserId + JWT\nleaseCount > 0
state SwitchingFocus : dispose + restore\nserializzato

[*] --> NoActiveIdentity : bootstrap\n[nessun restore ancora]

NoActiveIdentity --> SwitchingFocus : RequestFocusSwitch\n/ RunAsFocus
SwitchingFocus --> FocusActive : IdentityActivated\n[restore ok]
SwitchingFocus --> NoActiveIdentity : IdentitySwitchFailed

FocusActive --> SwitchingFocus : RequestFocusSwitch\n[altro focus,\nleaseCount = 0]
FocusActive --> FocusActiveLeased : AcquireIdentityLease
FocusActiveLeased --> FocusActive : ReleaseIdentityLease\n[leaseCount = 0]
FocusActiveLeased --> FocusActiveLeased : AcquireIdentityLease\n[stesso focus]

FocusActiveLeased --> FocusActiveLeased : RequestFocusSwitch\n[altro focus]\n/ IdentitySwitchDeferred
FocusActiveLeased --> SwitchingFocus : RequestFocusSwitch\n[stesso focus,\nreconnect]

FocusActive --> FocusActive : RunAsFocus\n[stesso focus]
FocusActive --> SwitchingFocus : RunAsFocus\n[altro focus,\nleaseCount = 0]

FocusActive --> NoActiveIdentity : AccountClosed\n[ultimo account disposed]

note right of FocusActiveLeased
  Durante lease:
  - RunAsFocus verso altro focus → deferred
  - AuthorizePushSync(AppResumed) → PushSyncDeferred
  - messaging/upload continua su activeFocusUserId
end note

@enduml
