@startuml seq-focus-account
' Context: navigation
' Profile: client
' Command: ShowInbox / EnterGroupShell → SwitchToAccount
' Revision: 2026-07-27

title seq-focus-account — sidebar switch

actor Utente
participant "UI" as UI
participant "NavigationMachine" as Nav
participant "MultiAccountMachine" as MAM

Utente -> UI : tap account
UI -> Nav : SwitchToAccount(userId)
Nav -> Nav : InvalidateConversationScope
Nav -> MAM : FocusAccount(userId)
MAM --> Nav : AccountFocused
alt account utente
  Nav --> UI : InboxVisible
else account gruppo
  Nav --> UI : GroupHomeVisible
end

@enduml
