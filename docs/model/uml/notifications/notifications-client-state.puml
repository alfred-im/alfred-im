@startuml notifications-client-state
' Context: notifications (client Flutter)
' SDD: PROM-PUSH-NOTIFY, SURF-NOTIFICATIONS
' Revision: 2026-07-27

title Notifications — client state machine (subscription + open chat)

state PushUnsupported : PushManager o SW assente
state PermissionDenied : permission === denied
state Idle : supportato, non ancora subscribed
state Syncing : SyncSubscriptions in corso
state Active : subscription attiva, manifest sincronizzato

state OpenChatIdle
state OpenChatQueued : intent in coda / pending
state OpenChatProcessing : handler serializzato

[*] --> PushUnsupported : CheckPushSupport\nPushUnsupportedDetected
[*] --> PermissionDenied : CheckPushSupport\nPermissionDeniedDetected
[*] --> Idle : CheckPushSupport\nSubscriptionIdleReached

Idle --> Syncing : SyncSubscriptionsRequested
Syncing --> Active : PushRegistrationSucceeded
Syncing --> Idle : PushRegistrationFailed
Active --> Syncing : SyncSubscriptionsRequested\n(login, resume, add account)
Active --> Idle : UnregisterSubscriptionRequested\n(ultimo account)

state c_subscription {
  PushUnsupported
  PermissionDenied
  Idle
  Syncing
  Active
}

state c_openchat {
  OpenChatIdle --> OpenChatQueued : OpenChatFromNotification\n[!sessionReady]\n/ ChatOpenFromNotificationDeferred
  OpenChatIdle --> OpenChatProcessing : OpenChatFromNotification\n[sessionReady && hasOpenAccount]
  OpenChatIdle --> OpenChatIdle : OpenChatFromNotification\n[!hasOpenAccount]\n/ ChatOpenFromNotificationFailed
  OpenChatQueued --> OpenChatProcessing : OpenChatFromNotification\n[sessionReady]\n/ da PushPlatform drain
  OpenChatProcessing --> OpenChatQueued : OpenChatFromNotification\n[chain busy]\n/ coda in-memory
  OpenChatProcessing --> OpenChatIdle : forwardOpenFromPushTap ok\n/ ChatOpenFromNotificationSucceeded
  OpenChatProcessing --> OpenChatIdle : forwardOpenFromPushTap fail\n/ ChatOpenFromNotificationFailed
  OpenChatQueued --> OpenChatProcessing : SessionBecameReady\n/ DrainPendingOpenChat\n(solo coda in-memory)
}

note right of OpenChatProcessing
  Effetto: forwardOpenFromPushTap
  → openFromPushTap → OpenConversation(source=push)
end note

note bottom of OpenChatQueued
  Pending persistito (localStorage):
  PushPlatform.tryDrainPendingOpenChat
  ri-emette OpenChatFromNotification
  (PushNotificationListener, non SessionBecameReady)
end note

@enduml
