@startuml seq-push-received
' Context: notifications
' Profile: client + SW
' Command: PresentPushNotification
' SDD: PROM-PUSH-NOTIFY-022, SURF-NOTIFICATIONS-005–008
' Revision: 2026-07-27

title seq-push-received — delivery server → notifica visibile o soppressa

participant "DeliveryWorker" as Del
participant "PushPlatform" as PP
participant "ServiceWorker" as SW
participant "PushSuppressionBinder" as Binder
participant "UI" as UI

Del -> PP : PushNotifyEnqueued
PP -> SW : push event

Binder -> PP : updateSuppression(snapshot)
PP -> SW : alfred_push_suppression

SW -> SW : PresentPushNotification\n(shouldSuppress?)

alt soppresso (chat attiva stessa coppia)
  SW -> SW : NotificationSuppressed\n(nessuna UI)
else mostra
  SW -> SW : NotificationShown
  SW -> UI : postMessage alfred_push_received
end

@enduml
