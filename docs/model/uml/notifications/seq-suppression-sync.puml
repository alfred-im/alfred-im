@startuml seq-suppression-sync
' Context: notifications
' Profile: client
' Command: UpdateInChatSuppression
' SDD: PROM-PUSH-NOTIFY-022–024, SURF-NOTIFICATIONS-008
' Revision: 2026-07-27

title seq-suppression-sync — client → service worker

participant "MultiAccountMachine" as MAM
participant "NavigationMachine" as Nav
participant "PushSuppressionBinder" as Binder
participant "PushPlatform" as PP
participant "ServiceWorker" as SW

MAM -> Binder : focus account changed
Nav -> Binder : active peer / chat visibility changed
Binder -> PP : updateSuppression(snapshot)
PP -> SW : postMessage alfred_push_suppression
SW -> SW : applySuppressionState

@enduml
