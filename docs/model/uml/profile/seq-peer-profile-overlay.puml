@startuml seq-peer-profile-overlay
' Context: profile (surfaccia peer-profile)
' Profile: client
' SDD: PROM-PEER-PROFILE
' Revision: 2026-07-27

title Scheda peer — azioni delegate

actor Utente
participant "UI" as UI
participant "ReceptionMachine" as RM
participant "ContactsMachine" as CM
participant "NavigationMachine" as Nav

Utente -> UI : ViewPeerProfile
UI --> Utente : PeerProfileDisplayed

opt consenso recapito
  Utente -> UI : TogglePeerConsent
  alt consente
    UI -> RM : AllowSender
  else revoca
    UI -> RM : DisallowSender
  end
end

opt rubrica
  Utente -> UI : TogglePeerInContacts
  alt aggiungi
    UI -> CM : AddContact
  else rimuovi
    UI -> CM : RemoveContact
  end
end

opt chat
  Utente -> UI : StartChatFromPeerProfile
  UI -> Nav : OpenConversation
end

opt condividi
  Utente -> UI : SharePeerProfile
  note right of UI
    Utility shareable-link
    (nessun evento statechart)
  end note
end

@enduml
