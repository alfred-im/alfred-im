@startuml seq-open-from-fragment
' Context: shareable-link → navigation | profile overlay
' Profile: client
' SDD: PROM-SHAREABLE-LINK
' Revision: 2026-07-27

title Link condiviso → profilo o chat

participant "Browser" as Br
participant "ShareableLinkMachine" as SL
participant "NavigationMachine" as Nav
participant "ProfileMachine" as PM

Br -> SL : ResolveSharedLink

alt fragment non valido o riservato
  SL --> Br : (resta Idle, nessun errore)
else sessione non pronta o 0 account
  SL --> Br : SharedLinkPending
else target chat
  Br -> SL : HandleSharedLinkTarget
  SL -> Nav : OpenSharedChat
  Nav --> SL : SharedChatOpened
else target profilo
  Br -> SL : HandleSharedLinkTarget
  SL -> PM : OpenSharedProfile
  PM --> SL : SharedProfileShown
else profilo assente
  Br -> SL : HandleSharedLinkTarget
  SL --> Br : SharedLinkInvalid
end

@enduml
